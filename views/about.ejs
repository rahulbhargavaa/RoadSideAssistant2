<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/navbar') %>

  <section class="page-header">
    <div class="container text-center">
      <h1>About RoadGuard</h1>
      <p>Your trusted partner on every journey</p>
    </div>
  </section>

  <section class="py-5">
    <div class="container">
      <div class="row align-items-center g-5">
        <div class="col-lg-6">
          <span class="section-tag">Who We Are</span>
          <h2 class="section-title">Committed To Keeping You Moving</h2>
          <p>RoadGuard is a Road Side Assistance Management System built to connect stranded drivers with nearby mechanics and support teams quickly and reliably. Whether it's a flat tyre, dead battery, or a complete breakdown, our platform makes it simple to request help and track it in real time.</p>
          <p>This project was developed as a college Final Year submission, demonstrating a complete full-stack MVC application using Node.js, Express, MongoDB and EJS, covering authentication, role-based dashboards, and complete request lifecycle management.</p>
        </div>
        <div class="col-lg-6 text-center">
          <i class="fa-solid fa-road-circle-check about-icon"></i>
        </div>
      </div>
    </div>
  </section>

  <section class="py-5 why-us-section">
    <div class="container">
      <div class="text-center mb-5">
        <span class="section-tag">Our Mission</span>
        <h2 class="section-title">Safety, Speed & Simplicity</h2>
      </div>
      <div class="row g-4 text-center">
        <div class="col-md-4">
          <div class="service-card">
            <i class="fa-solid fa-bolt"></i>
            <h5>Fast Response</h5>
            <p>We aim to connect you to help as fast as possible, minimizing wait times.</p>
          </div>
        </div>
        <div class="col-md-4">
          <div class="service-card">
            <i class="fa-solid fa-shield-halved"></i>
            <h5>Safety First</h5>
            <p>All mechanics and processes are designed keeping your safety in mind.</p>
          </div>
        </div>
        <div class="col-md-4">
          <div class="service-card">
            <i class="fa-solid fa-mobile-screen"></i>
            <h5>Easy To Use</h5>
            <p>A simple dashboard to request, track and manage your service requests.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>
  <%- include('partials/scripts') %>
</body>
</html>
