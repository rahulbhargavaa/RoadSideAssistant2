<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/navbar') %>

  <section class="dashboard-section">
    <div class="container-fluid">
      <div class="row">
        <div class="col-lg-3">
          <%- include('../partials/sidebar', { panel: 'admin', active: 'users' }) %>
        </div>
        <div class="col-lg-9">
          <div class="dashboard-content">
            <h3 class="mb-4"><i class="fa-solid fa-users me-2"></i>Manage Users</h3>

            <div class="dashboard-card">
              <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                <div class="input-group" style="max-width: 320px;">
                  <span class="input-group-text"><i class="fa-solid fa-search"></i></span>
                  <input type="text" id="userSearchInput" class="form-control" placeholder="Search by name, email or mobile...">
                </div>
                <span class="text-muted" id="userTotalCount"></span>
              </div>

              <div class="table-responsive">
                <table class="table align-middle table-hover">
                  <thead>
                    <tr>
                      <th>Name</th>
                      <th>Email</th>
                      <th>Mobile</th>
                      <th>Vehicle</th>
                      <th>Joined On</th>
                      <th>Action</th>
                    </tr>
                  </thead>
                  <tbody id="usersTableBody">
                    <!-- Populated via AJAX from dashboard.js -->
                  </tbody>
                </table>
              </div>

              <nav>
                <ul class="pagination justify-content-center" id="usersPagination"></ul>
              </nav>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <%- include('../partials/footer') %>
  <%- include('../partials/scripts') %>
  <script src="/js/dashboard.js"></script>
  <script>
    // Page-specific initializer
    document.addEventListener('DOMContentLoaded', function () {
      if (typeof initUsersPage === 'function') initUsersPage();
    });
  </script>
</body>
</html>
