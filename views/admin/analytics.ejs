<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/navbar') %>

  <section class="dashboard-section">
    <div class="container-fluid">
      <div class="row">
        <div class="col-lg-3">
          <%- include('../partials/sidebar', { panel: 'admin', active: 'analytics' }) %>
        </div>
        <div class="col-lg-9">
          <div class="dashboard-content">
            <h3 class="mb-4"><i class="fa-solid fa-chart-pie me-2"></i>Analytics</h3>

            <div class="row g-4">
              <div class="col-lg-6">
                <div class="dashboard-card">
                  <h5 class="mb-3">Requests By Status</h5>
                  <canvas id="statusChart" height="220"></canvas>
                </div>
              </div>
              <div class="col-lg-6">
                <div class="dashboard-card">
                  <h5 class="mb-3">Requests By Service Type</h5>
                  <canvas id="serviceTypeChart" height="220"></canvas>
                </div>
              </div>
              <div class="col-lg-12">
                <div class="dashboard-card">
                  <h5 class="mb-3">Requests Over Time</h5>
                  <canvas id="monthlyChart" height="120"></canvas>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <%- include('../partials/footer') %>
  <%- include('../partials/scripts') %>
  <script>
    const statusData = <%- statusCounts %>;
    const serviceTypeData = <%- serviceTypeCounts %>;
    const monthlyData = <%- monthlyData %>;

    const monthNames = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];

    // ---- Status Pie Chart ----
    new Chart(document.getElementById('statusChart'), {
      type: 'pie',
      data: {
        labels: statusData.map(s => s._id),
        datasets: [{
          data: statusData.map(s => s.count),
          backgroundColor: ['#0d6efd', '#198754', '#dc3545', '#ffc107', '#6f42c1', '#20c997', '#6c757d'],
        }]
      },
      options: { responsive: true }
    });

    // ---- Service Type Bar Chart ----
    new Chart(document.getElementById('serviceTypeChart'), {
      type: 'bar',
      data: {
        labels: serviceTypeData.map(s => s._id),
        datasets: [{
          label: 'Number of Requests',
          data: serviceTypeData.map(s => s.count),
          backgroundColor: '#0d6efd',
        }]
      },
      options: { responsive: true, scales: { y: { beginAtZero: true } } }
    });

    // ---- Monthly Line Chart ----
    new Chart(document.getElementById('monthlyChart'), {
      type: 'line',
      data: {
        labels: monthlyData.map(m => `${monthNames[m._id.month - 1]} ${m._id.year}`),
        datasets: [{
          label: 'Requests Created',
          data: monthlyData.map(m => m.count),
          borderColor: '#0d6efd',
          backgroundColor: 'rgba(13,110,253,0.15)',
          fill: true,
          tension: 0.3,
        }]
      },
      options: { responsive: true, scales: { y: { beginAtZero: true } } }
    });
  </script>
</body>
</html>
