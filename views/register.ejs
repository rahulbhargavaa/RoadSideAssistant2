<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/navbar') %>

  <section class="auth-section">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">
          <div class="auth-card">
            <div class="text-center mb-4">
              <i class="fa-solid fa-truck-medical auth-icon"></i>
              <h3 class="mt-3">Create Your Account</h3>
              <p class="text-muted">Join RoadGuard for reliable roadside assistance</p>
            </div>

            <% if (error) { %>
              <div class="alert alert-danger"><i class="fa-solid fa-circle-exclamation me-2"></i><%= error %></div>
            <% } %>

            <form action="/api/auth/register" method="POST" id="registerForm">
              <div class="row">
                <div class="col-md-6 mb-3">
                  <label class="form-label">Full Name</label>
                  <input type="text" name="name" class="form-control" placeholder="John Doe" value="<%= formData.name || '' %>" required>
                </div>
                <div class="col-md-6 mb-3">
                  <label class="form-label">Email Address</label>
                  <input type="email" name="email" class="form-control" placeholder="you@example.com" value="<%= formData.email || '' %>" required>
                </div>
              </div>
              <div class="row">
                <div class="col-md-6 mb-3">
                  <label class="form-label">Mobile Number</label>
                  <input type="text" name="mobile" class="form-control" placeholder="9876543210" value="<%= formData.mobile || '' %>" required>
                </div>
                <div class="col-md-6 mb-3">
                  <label class="form-label">Address</label>
                  <input type="text" name="address" class="form-control" placeholder="City, State" value="<%= formData.address || '' %>">
                </div>
              </div>
              <div class="row">
                <div class="col-md-6 mb-3">
                  <label class="form-label">Vehicle Type</label>
                  <select name="vehicleType" class="form-select">
                    <option value="Car">Car</option>
                    <option value="Bike">Bike</option>
                    <option value="Truck">Truck</option>
                    <option value="Bus">Bus</option>
                    <option value="Other">Other</option>
                  </select>
                </div>
                <div class="col-md-6 mb-3">
                  <label class="form-label">Vehicle Number</label>
                  <input type="text" name="vehicleNumber" class="form-control" placeholder="RJ14 AB 1234" value="<%= formData.vehicleNumber || '' %>">
                </div>
              </div>
              <div class="row">
                <div class="col-md-6 mb-3">
                  <label class="form-label">Password</label>
                  <input type="password" name="password" class="form-control" placeholder="Minimum 6 characters" required>
                </div>
                <div class="col-md-6 mb-3">
                  <label class="form-label">Confirm Password</label>
                  <input type="password" name="confirmPassword" class="form-control" placeholder="Re-enter password" required>
                </div>
              </div>
              <button type="submit" class="btn btn-emergency w-100 mt-2">Create Account</button>
            </form>

            <p class="text-center mt-4">Already have an account? <a href="/login">Login here</a></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>
  <%- include('partials/scripts') %>
</body>
</html>
