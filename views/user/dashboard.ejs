<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/navbar') %>

  <section class="dashboard-section">
    <div class="container-fluid">
      <div class="row">
        <div class="col-lg-3">
          <%- include('../partials/sidebar', { panel: 'user', active: 'dashboard' }) %>
        </div>
        <div class="col-lg-9">
          <div class="dashboard-content">
            <h3 class="mb-1">Welcome back, <%= user.name.split(' ')[0] %>!</h3>
            <p class="text-muted mb-4">Here's what's happening with your requests today.</p>

            <div class="row g-4 mb-4">
              <div class="col-md-6 col-xl-3">
                <div class="stat-card stat-primary">
                  <i class="fa-solid fa-clipboard-list"></i>
                  <h3><%= stats.totalRequests %></h3>
                  <p>Total Requests</p>
                </div>
              </div>
              <div class="col-md-6 col-xl-3">
                <div class="stat-card stat-warning">
                  <i class="fa-solid fa-hourglass-half"></i>
                  <h3><%= stats.pendingRequests %></h3>
                  <p>Pending</p>
                </div>
              </div>
              <div class="col-md-6 col-xl-3">
                <div class="stat-card stat-info">
                  <i class="fa-solid fa-truck-fast"></i>
                  <h3><%= stats.activeRequests %></h3>
                  <p>Active</p>
                </div>
              </div>
              <div class="col-md-6 col-xl-3">
                <div class="stat-card stat-success">
                  <i class="fa-solid fa-circle-check"></i>
                  <h3><%= stats.completedRequests %></h3>
                  <p>Completed</p>
                </div>
              </div>
            </div>

            <div class="row g-4">
              <div class="col-lg-8">
                <div class="dashboard-card">
                  <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0">Recent Requests</h5>
                    <a href="/user/track-request" class="btn btn-sm btn-outline-primary">View All</a>
                  </div>
                  <% if (recentRequests.length === 0) { %>
                    <p class="text-muted text-center py-4">No requests yet. <a href="/user/request-service">Create one now</a>.</p>
                  <% } else { %>
                    <div class="table-responsive">
                      <table class="table align-middle">
                        <thead><tr><th>Service</th><th>Location</th><th>Status</th><th>Date</th></tr></thead>
                        <tbody>
                          <% recentRequests.forEach(function(req) { %>
                            <tr>
                              <td><%= req.serviceType %></td>
                              <td><%= req.location %></td>
                              <td><span class="status-badge status-<%= req.status.replace(/\s+/g, '-').toLowerCase() %>"><%= req.status %></span></td>
                              <td><%= new Date(req.createdAt).toLocaleDateString() %></td>
                            </tr>
                          <% }); %>
                        </tbody>
                      </table>
                    </div>
                  <% } %>
                </div>
              </div>
              <div class="col-lg-4">
                <div class="dashboard-card">
                  <h5 class="mb-3"><i class="fa-solid fa-bell me-2"></i>Notifications</h5>
                  <% if (notifications.length === 0) { %>
                    <p class="text-muted text-center py-4">No notifications yet.</p>
                  <% } else { %>
                    <ul class="notification-list">
                      <% notifications.forEach(function(note) { %>
                        <li class="<%= note.read ? '' : 'unread' %>">
                          <p class="mb-1"><%= note.message %></p>
                          <small class="text-muted"><%= new Date(note.createdAt).toLocaleString() %></small>
                        </li>
                      <% }); %>
                    </ul>
                  <% } %>
                </div>
                <a href="/user/request-service" class="btn btn-emergency w-100 mt-3"><i class="fa-solid fa-triangle-exclamation me-2"></i>New Request</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <%- include('../partials/footer') %>
  <%- include('../partials/scripts') %>
</body>
</html>
