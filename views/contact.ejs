<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/navbar') %>

  <section class="page-header">
    <div class="container text-center">
      <h1>Contact Us</h1>
      <p>We'd love to hear from you</p>
    </div>
  </section>

  <section class="py-5">
    <div class="container">
      <div class="row g-4 mb-5 text-center">
        <div class="col-md-4">
          <div class="contact-info-card">
            <i class="fa-solid fa-phone"></i>
            <h6>Call Us</h6>
            <p>+91 8003608292</p>
          </div>
        </div>
        <div class="col-md-4">
          <div class="contact-info-card">
            <i class="fa-solid fa-envelope"></i>
            <h6>Email Us</h6>
            <p>lokeshb248@gmail.com</p>
          </div>
        </div>
        <div class="col-md-4">
          <div class="contact-info-card">
            <i class="fa-solid fa-location-dot"></i>
            <h6>Visit Us</h6>
            <p>Jodhpur, Rajasthan, India</p>
          </div>
        </div>
      </div>

      <div class="row justify-content-center">
        <div class="col-lg-8">
          <div class="auth-card">
            <h4 class="mb-4 text-center">Send Us A Message</h4>
            <form id="contactForm">
              <div class="row">
                <div class="col-md-6 mb-3">
                  <label class="form-label">Your Name</label>
                  <input type="text" class="form-control" placeholder="John Doe" required>
                </div>
                <div class="col-md-6 mb-3">
                  <label class="form-label">Your Email</label>
                  <input type="email" class="form-control" placeholder="you@example.com" required>
                </div>
              </div>
              <div class="mb-3">
                <label class="form-label">Subject</label>
                <input type="text" class="form-control" placeholder="How can we help?" required>
              </div>
              <div class="mb-3">
                <label class="form-label">Message</label>
                <textarea class="form-control" rows="4" placeholder="Write your message..." required></textarea>
              </div>
              <button type="submit" class="btn btn-emergency w-100">Send Message</button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>
  <%- include('partials/scripts') %>
  <script>
    // Simple client-side demo handler for the contact form (no backend persistence required for this static form)
    document.getElementById('contactForm').addEventListener('submit', function (e) {
      e.preventDefault();
      Swal.fire({
        icon: 'success',
        title: 'Message Sent!',
        text: 'Thank you for reaching out. Our team will get back to you shortly.',
        confirmButtonColor: '#0d6efd',
      });
      this.reset();
    });
  </script>
</body>
</html>
